%% F171 — Collection import respecting the source currency — User journey
flowchart LR
    subgraph UserLane["User"]
        U_SELECT(["Select CSV file"])
        U_REVIEW["Reviews detected currency"]
        U_OVERRIDE{"Override currency?"}
        U_CONFIRM["Confirms import"]
        U_END(["Sees import summary"])
    end

    subgraph FrontendLane["Frontend"]
        F_DRYRUN["CsvImportModal: dry-run request"]
        F_SHOW["Shows detected currency + confidence"]
        F_WARN["Low-confidence warning banner"]
        F_SUBMIT["Submits real import (currency=auto|BRL|USD)"]
        F_RESULT["Renders summary + price warnings"]
    end

    subgraph ApiLane["API"]
        A_DETECT["POST /collection/import?dry_run=true"]
        A_IMPORT["POST /collection/import"]
        A_RATE{"PTAX rate available?"}
    end

    subgraph DbLane["DB"]
        D_RATES[("exchange_rates")]
        D_COLLECTION[("user_collection.acquisition_price (BRL)")]
    end

    U_SELECT --> F_DRYRUN --> A_DETECT --> F_SHOW
    F_SHOW -->|"confidence: low"| F_WARN --> U_REVIEW
    F_SHOW -->|"confidence: high/medium"| U_REVIEW
    U_REVIEW --> U_OVERRIDE
    U_OVERRIDE -->|"yes"| U_CONFIRM
    U_OVERRIDE -->|"no, keep detected"| U_CONFIRM
    U_CONFIRM --> F_SUBMIT --> A_IMPORT --> A_RATE
    A_RATE -->|"USD amount, rate found"| D_RATES --> D_COLLECTION
    A_RATE -->|"USD amount, no rate: drop price + warning"| D_COLLECTION
    A_RATE -->|"BRL amount"| D_COLLECTION
    D_COLLECTION --> F_RESULT --> U_END

    subgraph PurchaseLane["Purchase HTML import"]
        P_UPLOAD(["User uploads purchase HTML"])
        P_PREVIEW["ImportPurchasesPage: preview matches"]
        P_RATE{"USD item: rate available?"}
        P_BADGE["Shows 'US$ x -> R$ y' badge"]
        P_UNMATCHED["Lists item as unmatched, reason: currency_conversion_failed"]
    end

    P_UPLOAD --> P_PREVIEW --> P_RATE
    P_RATE -->|"yes"| P_BADGE --> D_COLLECTION
    P_RATE -->|"no"| P_UNMATCHED
