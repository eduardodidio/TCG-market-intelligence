    style S fill:#e9c46a,stroke:#f4a261,color:#264653
    style Z fill:#2d6a4f,stroke:#40916c,color:#d8f3dc
    style AA fill:#264653,stroke:#2a9d8f,color:#e9c46a
    style AE fill:#264653,stroke:#2a9d8f,color:#e9c46a
