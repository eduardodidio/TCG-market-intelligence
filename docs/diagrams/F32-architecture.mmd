%%{ init: { 'theme': 'dark' } }%%
graph TB
    subgraph "Browser"
        UI["MyCollection Page"]
        CR["useCollectionRefresh"]
        SS["useScanStream (EventSource)"]
        PB["ScanProgressBar"]
        UI --> CR
        CR --> SS
        CR --> PB
    end

    subgraph "FastAPI Server"
        TRIG["POST /scans<br/>(trigger_scan)"]
        POLL["GET /scans/{id}<br/>(polling endpoint)"]
        SSE["GET /scans/{id}/stream<br/>(SSE endpoint)"]
        BUS["ScanEventBus<br/>(in-memory dict of asyncio.Queue)"]
    end

    subgraph "Background Thread"
        SCAN["Scan Orchestrator<br/>(run_scan)"]
        MYP["MYP Provider<br/>(fetch prices)"]
        SCAN --> MYP
    end

    subgraph "Database"
        DB["SQLite<br/>(scan_runs, price_observations)"]
    end

    %% Trigger flow
    CR -->|"1. POST /scans"| TRIG
    TRIG -->|"2. create scan_run"| DB
    TRIG -->|"3. start background thread"| SCAN

    %% Event flow
    SCAN -->|"4. publish ScanEvent"| BUS
    BUS -->|"5. queue.get()"| SSE
    SSE -->|"6. text/event-stream"| SS

    %% DB writes (unchanged)
    SCAN -->|"update_scan_run"| DB

    %% Fallback polling
    SS -.->|"fallback on error"| POLL
    POLL -->|"read scan_run"| DB

    %% Auth
    SSE -->|"validate ?token=JWT"| SSE

    style BUS fill:#0d9488,stroke:#14b8a6,color:#fff
    style SSE fill:#0891b2,stroke:#06b6d4,color:#fff
    style SCAN fill:#7c3aed,stroke:#8b5cf6,color:#fff
