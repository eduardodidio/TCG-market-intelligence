{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "HIGHLANDER MODE \u00e2\u20ac\u201d activates Claude Code Auto Mode on startup so Waves run autonomously without permission prompts. Liberal allow-list is kept as a fallback for sessions where auto mode is unavailable. Use only in sandboxed projects without secrets. Copy this over settings.json to activate.",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(didio:*)",
      "Bash(didio-*)",
      "Bash(mvn:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(pip:*)",
      "Bash(pytest:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(node:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(curl:*)",
      "Read(./**)",
      "Write(./**)",
      "Edit(./**)",
      "Bash(didio-spawn-agent*)",
      "Bash(didio-run-wave*)",
      "Bash(didio-dashboard*)",
      "Bash(git init:*)",
      "Bash(git -c user.name=*)",
      "Bash(mkdir -p:*)",
      "Bash(cp -r:*)",
      "Bash(npm install:*)",
      "Bash(npm run *)",
      "Write(tasks/**)",
      "Write(docs/**)",
      "Write(logs/**)",
      "WebSearch",
      "WebFetch",
      "AskUserQuestion"
    ]
  },
  "useAutoModeDuringPlan": true,
  "mcpServers": {
    "second-brain": {
      "command": "bun",
      "args": [
        "run",
        "/c/Workspace/didio-second-brain-claude/mcp-server/src/index.ts"
      ],
      "env": {}
    }
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /c/Workspace/didio-second-brain-claude/patterns/hooks/feature-end-digest/hook.sh"
          },
          {
            "type": "command",
            "command": "bash ${DIDIO_HOME:-$HOME/.claude-didio-config}/patterns/hooks/feature-end-digest/hook.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /c/Workspace/claude-didio-config/bin/hooks/didio-pre-tool.sh"
          },
          {
            "type": "command",
            "command": "bash ${DIDIO_HOME:-$HOME/.claude-didio-config}/bin/hooks/didio-pre-tool.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /c/Workspace/claude-didio-config/bin/hooks/didio-post-tool.sh"
          },
          {
            "type": "command",
            "command": "bash ${DIDIO_HOME:-$HOME/.claude-didio-config}/bin/hooks/didio-post-tool.sh"
          }
        ]
      }
    ]
  },
  "_hooks_decision": "Highlander runs Waves autonomously with no human watching the budget, so the session-guard (Pre/Post) and learning digest (Stop) hooks are wired here too. Stop hook points to second-brain hub for feature-end-digest (cross-project learning). Pre/Post hooks remain on didio-config framework."
}
