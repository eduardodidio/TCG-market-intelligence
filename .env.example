# Neon PostgreSQL connection string (pooled endpoint)
# Copy this file to .env and fill in your credentials
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- F172 deck suggestions (local daily routine) ---
# DECK_SUGGEST_PROVIDER=cli        # cli (claude -p, default) | api (Anthropic HTTP API)
# DECK_SUGGEST_CLAUDE_BIN=claude
# DECK_SUGGEST_MODEL=claude-sonnet-5
# DECK_SUGGEST_TIMEOUT=300
# ANTHROPIC_API_KEY=               # only for DECK_SUGGEST_PROVIDER=api — never commit
